# reference implementation, cloned for study, not part of the build
scratch/

# brand art at full resolution. `docs/media/` carries the optimised copies the README
# actually loads; these are the sources, and three megabytes of them is not something a
# clone should have to pull.
readme_renders/

# the design log, the original specification, the measurement notes and the design render.
# Kept on disk because the source comments cite them; not published (README says so).
private/

# local data and secrets
data/
.env

# rust
target/

# tauri build output: the permission schemas are regenerated from tauri.conf.json on every
# build, so committing them would mean reviewing a 60 KB diff nobody wrote
crates/app/gen/

# node / vite
node_modules/
ui/dist/

# os / editor
.idea/
.DS_Store

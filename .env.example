# quarrel configuration. Copy to `.env`. Never commit `.env`.
#
# Everything except live trading works with this file empty: indexing, backtesting,
# the feed, watching and scanning all run with no key at all (spec sec.7.3).

# --- network ------------------------------------------------------------------------
# Comma-separated, preferred first. Append #nologs to an endpoint that refuses
# eth_getLogs. Leave empty to use the built-in pair:
#   publicnode              state reads, fast, 8-way concurrency measured clean, no eth_getLogs
#   rpc.mainnet.chain...    logs, metered hard (measured: 429 above ~2 log calls/second)
# One private provider can carry everything; the gate will raise its own concurrency
# to match what the endpoint actually tolerates (AIMD, spec sec.6.3).
RPC_URL=

# Detection by subscription. Empty = publicnode's websocket. "off" = HTTP polling.
RPC_WS_URL=
# Optional hot-standby websocket, to shrink the blind window during a reconnect (sec.7).
RPC_WS_URL_STANDBY=

# Gate defaults. These are the measured-safe values for the PUBLIC endpoints; a private
# endpoint will be discovered to tolerate more and the gate will use more.
RPC_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400

# --- wallet ---------------------------------------------------------------------------
# Read by exactly one crate (quarrel-live) and needed only for --live.
# The plaintext trade-off is documented honestly in docs/SAFETY.md.
PRIVATE_KEY=

# --- data -----------------------------------------------------------------------------
# history.db (append-only facts) and live.db (positions, budget, journal) live here.
QUARREL_DATA_DIR=./data
